# Copy to `.env` for LOCAL runs only. Never commit `.env` (it is gitignored).
#
# On GitHub Actions the token is provided as the repository secret
# TELEGRAM_BOT_TOKEN instead — do not put it in any file.
#
# Create the bot with @BotFather on Telegram, then paste the token here.

TELEGRAM_BOT_TOKEN=

# Optional: destination chat for local runs. On GitHub Actions this is the
# TELEGRAM_CHAT_ID repository secret instead -- never put it in committed
# files. Get your chat id from @userinfobot in Telegram, or run bot.py once
# and send /start (the bot replies with these instructions).
# TELEGRAM_CHAT_ID=

# Optional local tuning (defaults shown).
# TIMEZONE=Asia/Kolkata
# CHECK_INTERVAL_SECONDS=1800
# DAILY_REPORT_HOUR=9
# DAILY_REPORT_MINUTE=0
# REQUEST_DELAY_SECONDS=2
